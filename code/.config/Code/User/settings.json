{
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.disableAIFeatures": true,
  "cSpell.customDictionaries": {
    "Main": {
      "name": "Main",
      "path": "~/.config/Code/User/dictionary.txt",
      "description": "Kexi's custom dictionary",
      "addWords": true
    },
  },
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.language": "en, ru, fr",
  "cSpell.showInRuler": false,
  "editor.formatOnSave": false,
  "editor.fontFamily": "Lilex Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lightbulb.enabled": "off",
  "editor.mouseWheelZoom": false,
  "editor.occurrencesHighlight": "off",
  "editor.renderFinalNewline": "dimmed",
  "editor.renderWhitespace": "trailing",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { // italic comments
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.unicodeHighlight.includeComments": false,
  "editor.unicodeHighlight.includeStrings": false,
  "explorer.compactFolders": false,
  "explorer.expandSingleFolderWorkspaces": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "files.exclude": {
    ".directory": true // directory's metadata file for KDE Plasma
  },
  "git.autofetch": false,
  "git.blame.editorDecoration.template": "${subject} (${authorName})",
  "git.blame.statusBarItem.template": "${authorName}",
  "git.openRepositoryInParentFolders": "never",
  "network.meteredConnection": "off",
  "security.workspace.trust.startupPrompt": "always",
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "crash",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "Lilex Nerd Font",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.mouseWheelZoom": false,
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/usr/bin/bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/usr/bin/zsh"
    },
    "fish": {
      "path": "fish"
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "off",
    "arguments": "off",
    "unknown": "off"
  },
  "update.mode": "none",
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  "window.newWindowDimensions": "fullscreen",
  "window.restoreFullscreen": true,
  "window.title": "${dirty}${rootNameShort}${profileName}${separator}Code",
  "window.titleSeparator": " ⋅ ",
  "window.zoomLevel": 1,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Dark Modern",
  "workbench.experimental.modernUI": true,
  "workbench.iconTheme": "a-file-icon-vscode",
  "workbench.layoutControl.enabled": false,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none",
  "workbench.tree.enableStickyScroll": false
}
