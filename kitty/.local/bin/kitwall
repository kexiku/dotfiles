#!/bin/bash
set -euo pipefail

out="${XDG_CONFIG_HOME:-$HOME/.config}/background-kitty"
hash="${XDG_CACHE_HOME:-$HOME/.cache}/background-kitty.hash"

# Default options
size="1920x1080"
blur=16
brightness=-20
contrast=-25

# Show help info
usage() {
  cat << EOF
Kitwall: Create a a background image for kitty terminal

Usage: ${0##*/} [options]

  -s, --size WxH        Max size, only shrinks larger images (default: $size)
  -b, --blur N          Blur sigma (default: $blur)
  -B, --brightness N    Brightness, -100...100 (default: $brightness)
  -c, --contrast N      Contrast, -100...100 (default: $contrast)
  -h, --help            Show this help
EOF
}

# Parse options
while (($#)); do
  case $1 in
    -s|--size)       size=${2:?missing value for $1};       shift 2 ;;
    -b|--blur)       blur=${2:?missing value for $1};       shift 2 ;;
    -B|--brightness) brightness=${2:?missing value for $1}; shift 2 ;;
    -c|--contrast)   contrast=${2:?missing value for $1};   shift 2 ;;
    -h|--help)       usage; exit 0 ;;
    *) echo -e "Unknown option: $1 \n" >&2; usage >&2; exit 2 ;;
  esac
done

# Check ImageMagick version
if ! command -v magick > /dev/null; then
  echo "kitwall: magick command not found (ImageMagick v7 is required)" >&2
  exit 1
fi

# Define Gnome color scheme
color_scheme=$(gsettings get org.gnome.desktop.interface color-scheme)

# Define the picture uri key based on color theme
if [[ $color_scheme == *dark* ]]; then
  key="picture-uri-dark"
else
  key="picture-uri"
fi

# Get background image path
bg_schema="org.gnome.desktop.background"

uri=$(gsettings get "$bg_schema" "$key")
uri=${uri//\'/} # Remove single quotes
uri=${uri#file://} # Remove the 'file://' prefix
uri=$(printf '%b' "${uri//%/\\x}") # Decode URI-encoded characters

# Check if the background image exists
if [[ ! -f $uri ]]; then
  echo "kitwall: background image not found at '$uri'" >&2
  exit 1
fi

# Check if the background image file is valid
if [[ ! -s $uri ]]; then
  echo "kitwall: invalid background image at '$uri'" >&2
  exit 1
fi

# Hash the background image & all adjustment parameters
new_hash=$(
  {
    sha256sum < "$uri"
    echo "$size $blur $brightness $contrast"

  } | sha256sum | cut -d' ' -f1 # Extract hash digest
)

# Check if the output image exists
if [[ -f $hash && $(<"$hash") == "$new_hash" && -f $out ]]; then
  echo "kitwall: image already exists, exit with no changes"
  exit 0
fi

# Make sure required directories are set
mkdir -p "$(dirname "$out")" "$(dirname "$hash")"

# Create a temporary copy of the output file
tmp=$(mktemp "$out.XXXXXX")

# Clean temp files on exit
trap 'rm -f "$tmp"' EXIT

# Edit the image
magick "$uri" \
  -resize "${size}>" \
  -blur "0x${blur}" \
  -brightness-contrast "${brightness}x${contrast}" \
  "$tmp"

# Write changes to the output file
mv "$tmp" "$out"

# Save output image hash
echo "$new_hash" > "$hash"
