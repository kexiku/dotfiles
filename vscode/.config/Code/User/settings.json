{
    "update.mode": "none",
    "window.zoomLevel": 1,
    "window.restoreFullscreen": true,
    "window.newWindowDimensions": "fullscreen",
    "window.commandCenter": false,
    "workbench.tree.enableStickyScroll": false,
    "workbench.activityBar.location": "top",
    "workbench.layoutControl.enabled": false,
    "workbench.iconTheme": "a-file-icon-vscode",
    "workbench.startupEditor": "none",
    "editor.tabSize": 2,
    "editor.mouseWheelZoom": true,
    "editor.lightbulb.enabled": "off",
    "editor.occurrencesHighlight": "off",
    "editor.stickyScroll.enabled": false,
    "editor.stickyScroll.scrollWithEditor": false,
    "editor.unicodeHighlight.includeStrings": false,
    "editor.unicodeHighlight.includeComments": false,
    "js.suggest.autoImports": false,
    "files.exclude": {
        ".directory": true
    },
    "cSpell.language": "en, ru, fr",
    "cSpell.userWords": [
        "allclear",
        "bson",
        "dconf",
        "distro",
        "Excretus",
        "FINDBAR",
        "flathub",
        "Flatpaks",
        "Flatseal",
        "genderize",
        "gparted",
        "gsettings",
        "hornswaddle",
        "Kexi",
        "linebreak",
        "magick",
        "mattjakeman",
        "miamoremustachio",
        "noninteractive",
        "nuska",
        "Okular",
        "oleg",
        "pacman",
        "pkgs",
        "plusplus",
        "rpms",
        "sinonim",
        "taskrefs",
        "tchx",
        "waiwai"
    ],
    "cSpell.diagnosticLevel": "Hint",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "terminal.integrated.sendKeybindingsToShell": true,
    "explorer.compactFolders": false,
    "chat.commandCenter.enabled": false,
    "git.blame.editorDecoration.template": "${subject} (${authorName})",
    "git.blame.statusBarItem.template": "${authorName}",
    "git.openRepositoryInParentFolders": "never",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "terminal.integrated.stickyScroll.enabled": false,
    "chat.agent.enabled": false,
    "chat.disableAIFeatures": true,
    "cSpell.showInRuler": false,
    "window.menuBarVisibility": "compact",
    "editor.fontFamily": "Lilex Nerd Font",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "terminal.integrated.suggest.quickSuggestions": {
        "commands": "off",
        "arguments": "off",
        "unknown": "off"
    },
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/usr/bin/bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "/usr/bin/zsh"
        },
        "fish": {
            "path": "fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "editor.tokenColorCustomizations": { // For italic comments
        "textMateRules": [
            {
                "scope": "comment",
                "settings": {
                    "fontStyle": "italic"
                }
            }
        ]
    },
    "terminal.integrated.fontFamily": "Lilex Nerd Font",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.mouseWheelZoom": true,
    "workbench.colorTheme": "Dark Modern"
}
