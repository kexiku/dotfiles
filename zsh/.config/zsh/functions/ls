# ls: A wrapper that adds a custom header to ls
#
emulate -L zsh

# Return if output is not a terminal
[[ ! -t 1 ]] && command ls "$@" && return

# Check if long listing format enabled
local is_long_format=0
local arg

for arg ($@); do
  [[ $arg == -- ]] && break;

  if [[ $arg == -[^-]* && ${arg#-} == *l* ]]; then
    is_long_format=1
  fi
done

# Save the ls output and exit code
local out ret
out=$(command ls -C --color=always --group-directories-first "$@")
ret=$?

# Return if ls fails
(( $ret )) && return $ret

# Print the header
if (( is_long_format )); then
  local -a lines=( "${(@f)out}" ) # Count the lines in output
  local -i items=$(( $#lines - 1 )) # Exclude the "total N" line
  _dir_header $items
fi

# Print the raw output
print -r -- "$out"
