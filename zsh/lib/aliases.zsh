# file system navigation
# moving up
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'

# directory stack
alias -- -='cd -'
alias 1='cd -1'
alias 2='cd -2'
alias 3='cd -3'
alias 4='cd -4'
alias 5='cd -5'
alias 6='cd -6'
alias 7='cd -7'
alias 8='cd -8'
alias 9='cd -9'

# list contents
alias ls='ls --group-directories-first'
alias l='ls -lah'
alias la='ls -lAh'
alias lsa='ls -lah'
alias ll='ls -lh'

# other aliases
alias md='mkdir -p'
alias rd='rmdir'

alias c='clear'
alias cl='clear'

alias df='df -h'
